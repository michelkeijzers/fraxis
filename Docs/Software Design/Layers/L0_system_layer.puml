@startuml
top to bottom direction

title L0 SYSTEM TASK

skinparam packageStyle rectangle
skinparam lineThickness 2

class main 
{
}

class WindowsSimulator 
{

}

class Orchestrator 
{
    + Run()
    + ValidateDeviceSettings()
    - CreateLinks()
    - LinkDeviceModelsToDeviceDrivers()
    - InitializeDeviceModels()
    - InitializeDevicesDrivers()
    - InitializeTasks()
    - StartTasks()
}

main *-- Orchestrator
main *-- Context
WindowsSimulator *-- Orchestrator
WindowsSimulator *-- Context 

class DeviceSettingsValidator
{
    + <<static>> Validate()
    - <<static>> ValidatePins()
    - <<static>> ValidateI2c()
    - <<static>> ValidateMcp23017()
}

DeviceSettingsValidator o-- DeviceSettings
Orchestrator *-- DeviceSettingsValidator

class Builder <<L1 Compositions Layer>> {}
class EspBuilder  <<L1 Compositions Layer>> {}
class WindowsBuilder  <<L1 Compositions Layer>> {}
class Context <<L1 Compositions Layer>> {}

EspBuilder -|> Builder
WindowsBuilder -|> Builder

main --> EspBuilder
WindowsSimulator --> WindowsBuilder

Orchestrator o-- Builder
Orchestrator o-- Context

class RtosTask <<L8 Service Layer>>
{
    + <<abstract>> Start()
    + <<abstract>> DelayTask(uint32_t ms)
    + <<abstract>> GetTaskTickCount()
    + <<abstract>> CreateQueue(
        uint32_t queueLength, \n uint32_t itemSize): RtosQueue*
}
ApplicationsTask -u-|> Task

class Task
{   
    + SetRtosTask(RtosTask& rtosTask)
    + GetRtosTask(): RtosTask& 
    + <<abstract>> Initialize()
    + <<abstract>> Run()
}

Task *-- RtosTask

Orchestrator *-- ApplicationsTask 

class I2cTask <<I2cTask, L0 Systems Layer>> #yellow
{
    + Initialize()
    + Run()
    + <<static>> TaskEntry(void* param);
}

I2cTask -u-|> Task
I2cTask o-- Context

class IoPins <<L4 Domain Models>> {}
I2cTask o-- IoPins 
class Displays <<L4 Domain Models>> {}
I2cTask o-- Displays 
class OutputQueue <<L3 Messages>> {}
I2cTask o-- OutputQueue 
class OutputQueueReader <<L4 Domain Models>> {}
I2cTask o-- OutputQueueReader 
class I2cTaskDeviceDriversDelegate <<L6 Device Drivers>> {}
I2cTask o-- I2cTaskDeviceDriversDelegate 

Orchestrator *-- I2cTask

class ApplicationsTask <<L2 Applications Layer>> #gold
{
}

class LedStripsTask <<LedStripTask>> #lightblue
{
    + Initialize()
    + Run()
    + <<static>> void TaskEntry(void* param);    
}

LedStripsTask -u-|> Task
LedStripsTask o-- Context
Orchestrator *-- LedStripsTask

class DeviceSettings
{
    + <<static>> const uint8_t PIN_I2C_SCL
    + <<static>> const uint8_t PIN_I2C_SDA
    + <<static>> const uint8_t PIN_LED_STRIP_DATA
    + <<static>> const uint8_t I2C_PORT
    + <<static>> const uint32_t I2C_FREQUENCY
    + <<static>> const uint8_t I2C_ADDRESS_MCP_23017
    + <<static>> const uint8_t I2C_ADDRESS_LCD_2004
}

Orchestrator *-- DeviceSettings

@enduml
