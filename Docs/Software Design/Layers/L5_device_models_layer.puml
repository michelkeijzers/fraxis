@startuml

title L5 DEVICE MODELS LAYER

skinparam packageStyle rectangle
skinparam lineThickness 2

class DeviceModelsContext <<L1_Composition>>
{
}

class IDirty <<Utility>>
{
}

class IDeviceModel
{
    + <<abstract>> Initialize()
}

class DeviceModel 
{
    - bool _isDirty 
    + IsDirty() : bool
    + MarkDirty()
    + ClearDirty()
}

DeviceModel -u-|> IDeviceModel
DeviceModel -u-|> IDirty

class Ws28xxModel #lightblue
{
    - uint16_t _numberOfPixels
    - uint8_t _pixels[numberOfPixels]
    - uint8_t dataPin
    + Initialize()
    + SetDataPin(uint8_t dataPin)
    + SetPixel(uint16_t index, RGB color)
}

Ws28xxModel -u-|> DeviceModel

class I2cTaskDelegateDeviceModels #yellow
{
    void Run()
}

class Mcp23017Model <<I2cTask>> #yellow
{
    - uint16_t _gpioStates
    - uint8_t _i2cAddress
    - uint16_t _inputsMask
    + Initialize()
    + SetI2cModel(I2cModel& i2cModel)
    + SetI2cAddress(uint8_t i2cAddress) 
    + SetInputsMask(uint16_t inputsMask)
}

Mcp23017Model -u-|> DeviceModel

Mcp23017Model o-- I2cModel

class Tm1637Model <<I2cTask>> #yellow
{
    - uint8_t _clkPin
    - uint8_t _dataPin
    + Initialize()
    + SetClkPin(uint8_t clkPin)
    + SetDataPin(uint8_t dataPin)
    + SetValue(uint16_t value, uint16_t specialSymbols)
}

Tm1637Model -u-|> DeviceModel

class Lcd2004Model <<I2cTask>> #yellow
{
    + Initialize()
    + GetI2cAddress(): uint8_t
    + SetI2cAddress(uint8_t i2cAddress) 
    + EnableScreen(bool on)
    + SetCursor(uint8_t x, uint8_t y)
    + EnableCursor(bool on)
    + GetPreviousLine(uint8_t lineNumber) 
    + GetLine(uint8_t lineNumber)
    + SetLine(uint8_t line, std::string text)
    + IsCursorDirty() : bool
    + ClearCursorDirty()
    + GetDirtyLineNumber() : int8_t
    + UpdateLine(uint8_t lineIndex)
    + bool PerCharacterStrategy(uint8_t lineIndex)
    - <<static>> const uint8_t 
        FULL_LINE_STRATEGY_CHARACTERS = 17;
    - uint8_t _i2cAddress;
    - string _previousLines[4];
    - string _lines[4];
    - uint8_t _cursorPositionX;
    - uint8_t _cursorPositionY;  
    - bool _cursorEnabled;
    - bool _isCursorDirty;
}

Lcd2004Model -u-|> DeviceModel

DeviceModelsContext *-- Ws28xxModel
DeviceModelsContext *-- Mcp23017Model
DeviceModelsContext *-- Tm1637Model
DeviceModelsContext *-- Lcd2004Model

I2cTaskDelegateDeviceModels o-- DeviceModelsContext

@enduml
