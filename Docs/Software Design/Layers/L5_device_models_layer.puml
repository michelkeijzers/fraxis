@startuml

title 5 DEVICE MODELS LAYER

skinparam packageStyle rectangle
skinparam lineThickness 2

class DeviceSettings
{
    + <<static>> const uint8_t PIN_I2C_SCL
    + <<static>> const uint8_t PIN_I2C_SDA
    + <<static>> const uint8_t PIN_WS2812_DATA
    + <<static>> const uint8_t I2C_ADDRESS_LCD_2004
    + <<static>> const uint8_t I2C_ADDRESS_MCP_23017
}

class DeviceModelsContext <<L1_Composition>>
{
}

class IDirty <<Utility>>
{
}

class IDeviceModel
{
    + <<abstract>> Initialize()
}

class DeviceModel 
{
    - bool _isDirty 
    + IsDirty() : bool
    + MarkDirty()
    + ClearDirty()
}

DeviceModel -u-|> IDeviceModel
DeviceModel -u-|> IDirty

class Ws28xxModel #lightblue
{
    - uint16_t _numberOfPixels
    - uint8_t _pixels[numberOfPixels]
    - uint8_t dataPin
    + Initialize()
    + SetDataPin(uint8_t dataPin)
    + SetPixel(uint16_t index, RGB color)
    + WriteToDriver()
}

Ws28xxModel -u-|> DeviceModel

class I2cTaskDelegateDeviceModels #yellow
{
    void Run()
}

class I2cModel <<I2cTask>> #yellow
{
    - uint8_t _sdaPin 
    - uint8_t _sclPin 
    + Initialize()
    + GetClockPin(): uint8_t
    + SetClockPin(uint8_t clkPin)
    + GetSdaPin(): uint8_t
    + SetSdaPin(uint8_t sdaPin)
}

I2cModel -u-|> DeviceModel

class Mcp23017Model <<I2cTask>> #yellow
{
    - uint16_t _gpioStates
    - uint8_t _i2cAddress
    - uint16_t _inputsMask
    + Initialize()
    + SetI2cModel(I2cModel& i2cModel)
    + SetI2cAddress(uint8_t i2cAddress) 
    + SetInputsMask(uint16_t inputsMask)
    + ReadGpiosFromDriver(): uint16_t
    + WriteGpiosToDriver(uint16_t gpioStates)
}

Mcp23017Model -u-|> DeviceModel

Mcp23017Model o-- I2cModel

class Tm1637Model <<I2cTask>> #yellow
{
    - uint8_t _clkPin
    - uint8_t _dataPin
    + Initialize()
    + SetClkPin(uint8_t clkPin)
    + SetDataPin(uint8_t dataPin)
    + SetValue(uint16_t value, uint16_t specialSymbols)
    + WriteToDriver()
}

Tm1637Model -u-|> DeviceModel

class Lcd2004Model <<I2cTask>> #yellow
{
    - uint8_t _i2cAddress
    - std::string[4] _lines
    - uint8_t _cursorX
    - uint8_t _cursorY
    + Initialize()
    + SetI2cModel(I2cModel& i2cModel)
    + SetI2cAddress(uint8_t i2cAddress) 
    + EnableScreen(bool on)
    + WriteLine(uint8_t line, std::string text)
    + SetCursor(uint8_t x, uint8_t y)
    + EnableCursor(bool on)
    + WriteToDriver()
}

Lcd2004Model o-- I2cModel

Lcd2004Model -u-|> DeviceModel

DeviceModelsContext *-- Ws28xxModel
DeviceModelsContext *-- I2cModel 
DeviceModelsContext *-- Mcp23017Model
DeviceModelsContext *-- Tm1637Model
DeviceModelsContext *-- Lcd2004Model

I2cTaskDelegateDeviceModels o-- DeviceModelsContext

Ws28xxModel ..> DeviceSettings
I2cModel ..-> DeviceSettings
Mcp23017Model ..> DeviceSettings
Lcd2004Model ..> DeviceSettings
Tm1637Model ..> DeviceSettings

@enduml
