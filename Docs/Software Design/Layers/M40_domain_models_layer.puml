@startuml M40 Domain Models Module

title M40 DOMAIN MODELS MODULE

skinparam packageStyle rectangle
skinparam lineThickness 2

interface IDomainModel 
{
}

class DomainModel 
{
    DomainModel()
    <<abstract>> SetDeviceModel(IDeviceModel& deviceModel)
}

DomainModel -u-|> IDomainModel

class QueueProcessor <<M30_Messages>> {}

class ApplicationsTask <<M20 Applications>>


package "LedStrips" as LedStripsPackage
{
    class LedStripsTask <<LedStripTask>> #lightblue
    {
        + Initialize()
        + Run()
    }

    ApplicationsTask ..> LedStripsTask : Initialize

    class LedStrips  <<LedStripTask>> #lightblue
    {
        + LedStrips()
        + GetWs28xxDeviceModel : Ws28xxDeviceModel
        + SetDeviceModel(\n IDeviceMOdel deviceModel)
        + SetBrightness(uint8_t brightness)
        + SetPixel(uint8_t horizontal, uint8_t vertical, RGB color)
        + SetFrameReady()
        + GetOrientation() const : Types_ELedStripsOrientation
        - SwapXyIfVertical(Position& position)
        - GetDeviceModelLedIndex() const : Position&
        - leds : Color[NUMBER_OF_LEDS_PER_LED_STRIP]\n [NUMBER_OF_LED_STRIPS]
        - _orientation : Types_ELEdStripsOrientation
    }

    LedStrips -u-|> DomainModel
    LedStripsTask o- LedStrips

    class LedStripsQueueReader #lightblue
    {
        + LedStripsQueueReader(\n LedStripsQueue& ledSTripsQueue,\n LedStrips& ledStrips)
        + HandleMessage()
        - GetLedStripsQueue()
        - _ledStrips : LedStrips&
    }

    class LedStripsQueue <<M30_Messages>> #lightblue

    LedStripsQueueReader o-- LedStripsQueue
    LedStripsQueueReader o-- LedStrips
    LedStripsQueueReader -u-|> QueueProcessor
}

package "I2c" as I2cPackage
{
    class I2cTask <<I2cTask, M00 Systems Layer>> #yellow
    {
    }

    I2cTask *-- IoPins
    ApplicationsTask ...> I2cTask : Initialize

    class I2cTaskDelegateDeviceModels <<M50_DeviceModels>> #yellow
    {
    }

    I2cTask *- I2cTaskDelegateDeviceModels

    class IoPins <<I2cTask>> #yellow
    {
        + IoPins()
        + GetLedById(Types::ELedId ledId): Led
        + GetJoystick(Types::EJoystickId joystickId): Joystick
        + GetSystemButton()
        + UpdateInputs()
        + GetDeviceModel() : Mcp23017DeviceModel&
        + SetDeviceModel(IDeviceModel& deviceModel)
    }

    class Mcp23017DeviceModel <<M50 Device Models>>
    IoPins o-- Mcp23017DeviceModel


    IoPins -u-|> DomainModel

    class Joystick  <<I2cTask>> #yellow
    {
        + Joystick(IoPins& ioPins, Types::EJoystickId joystickId)
        + GetId() : Types::EJoystickId
        + GetDirection() : Types::EJoystickDirection
        + GetButtonState(): bool
        + GetButtonState() : bool
        + UpdateInputs()
        + GetButtonStateDirty() : Dirty 
        + GetDirectionDirty() : Dirty
        - IoPins& _ioPins
        - Types::EJoystickId _id
        - bool _buttonState
        - Types::EJoystickDirection _direction
        - UpdateButtonState()
        - UpdateDirection()
    }

    class Dirty <<M90 Utilities>> {}

    Joystick *-- "2" Dirty : _buttonStateDirty, \n_directionDirty

    IoPins o-- "2" Joystick : (Player1, \nPlayer2)

    class SystemButton <<I2cTask>> #yellow
    {
        + SystemButton(IoPins& ioPins)
        + UpdateInput()
        + GetState(): bool 
        + GetStateDirty& Dirty&
        - bool _state
    }

    SystemButton *-- Dirty : _dirty

    SystemButton -u-|> DomainModel
    IoPins o-- "1" SystemButton 
    SystemButton o-- IoPins

    class Displays <<I2cTask>> #yellow
    {
        + Displays()
        + Lcd2004& GetLcd2004()
        + ETm1637Id& GetTm1637CentralPanel
        + ETm1637Id& GetTm1637Player1
        + ETm1637Id& GetTm1637CPlayer2
        + GetLcd2004() : Lcd2004
    }

    Displays -u-|> DomainModel
    I2cTask *-- Displays

    class Led <<I2cTask>> #yellow
    {
        + Led(IoPins& ioPins, Types::ELedId ledId)
        + GetState(): bool
        + SetState(bool state)
        - _ledId : Types::ELedId
        - _state: bool
    }

    Led -u-|> DomainModel
    IoPins o-- "5" Led : (PlayPause,\nSelect,\nSetup,\nPlayer1,\nPlayer2)
    Led o-- IoPins

    class Lcd2004 <<I2cTask>> #yellow
    {
        + Lcd2004()
        + NUMBER_OF_LINES {static} : const uint8_t = 4
        + const uint8_t LINE_WIDTH {static } : const uint8_t = 20
        + SetDeviceModel(IDeviceModel& deviceModel)
        + SetPredefinedCharacter(\n uint8_t slotIndex,\n uint8_t predefinedCharacterIndex)
        + SetCustomCharacter(\n uint8_t slotIndex, uint8_t data[8])
        + SetLine(uint8_t lineNumber, string line)
        - bool _screenEnabled
        - string _lines[4]
    }

    class Lcd2004DeviceModel <<M50 Device Models>>
    Lcd2004 o-- Lcd2004DeviceModel

    Lcd2004 -u-|> DomainModel
    Displays o-- Lcd2004

    class Tm1637 <<I2cTask>> #yellow
    {
        + Tm1637()
        + SetDeviceModel(\n IDeviceModel& deviceModel)
        + Enable(bool on)
        + SetBrightness(uint8_t brightness)
        + SetValue(int value)
        + SetTime(int first, int second) 
        + TODO_SetText(string text)
        - EFormat { Value, Time, Text }
        - _format : EFormat
        - _first
        - _second
    }

    Tm1637 -u-|> DomainModel
    Displays o-- "3" Tm1637 : (CENTRAL_PANEL,\n PLAYER_1,\n PLAYER_2)

    class DeviceModelsContext <<M10 Composition Layer>> {}

    Displays o-- DeviceModelsContext
    IoPins o-- DeviceModelsContext

    class I2cOutputQueueReader #yellow
    {
        + I2cOutputQueueReader(I2cOutputQueue& i2cOutputQueue, IoPins& ioPins, Displays& displays)
        + HandleMessage() : bool
    }

    I2cOutputQueueReader -u-|> QueueProcessor
    I2cOutputQueueReader o-- IoPins
    I2cOutputQueueReader o-- Displays

    class I2cOutputQueue <<M30_Messages>> #yellow

    I2cOutputQueueReader o-- I2cOutputQueue

    class I2cInputQueueWriter #yellow
    {
        + I2cInputQueueWriter(I2cInputQueue& i2cInputQueue, IoPins& ioPins);
        + SendMessages()
        - SendJoystickMessages(Joystick& joystick)
        - SendSystemButtonMessage(SystemButton& systemButton)
    }

    I2cInputQueueWriter -u-|> QueueProcessor

    class I2cInputQueue <<M30 Messages>> #yellow

    I2cInputQueueWriter o-- I2cInputQueue
    I2cInputQueueWriter o-- IoPins
}

package "Spi" as SpiPackage
{
    class SpiInputQueueWriter 
    {
        
    }

    class SpiOutputQueueReader
    {

    }
}

@enduml
