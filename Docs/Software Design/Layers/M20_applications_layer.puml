@startuml

title M20 APPLICATIONS LAYER

skinparam packageStyle rectangle
skinparam lineThickness 2

class ApplicationsTask 
{
    + ApplicationsTask(Context& context)
    + Initialize()
    + Run()
    + static void TaskEntry(void* param)
    - _context : Context
    - _ledStripsQueue : LedStripsQueue
    - _i2cInputQueue : I2cInputQueue
    - _i2cOutputQueue : I2cOutputQueue
    - _spiInputQueue : SpiInputQueue
    - _spiOutputQueue : SpiOutputQueue
}

class Task <<M00 System Task>>
{   
}

ApplicationsTask -u-|> Task

interface IEventListener
{
    + IEventListener()
    + <<abstract>> OnJoystickDirectionChanged(
        IoStates::EJoystickId id, \nJoystickState::EDirection direction)
    + <<abstract>> OnJoystickButtonChanged(
        IoState:EJoystickId id, bool state)
    + <<abstract>> OnSystemButtonChanged(bool state)
    + <<abstract>> OnSdCardRead()
}

class ApplicationsManager
{
    + ApplicationsManager(
        Context& context);
    + GetQueueWriters() : QueueWriters&
    + SetQueueWriters(QueueWriters& queueWriters)
    + SetNvsSettings(NvsSettings& nvsSettings)
    + AddApplications()
    + OnJoystickDirectionChanged(
        IoStates::EJoystickId id, \nJoystickState::EDirection direction)
    + OnJoystickButtonChanged(\n IoState:EJoystickId id, bool state)
    + OnSystemButtonChanged(bool state)
    + Run()
    + GetIoStates() : IoStates&
    + GetApplications() : std::vector<std::unique_ptr<Application>>&
    + GetActiveApplication() : Application&
    + SetActiveApplication(Application& application)
    + PauseApplication(Application& application)
    + ResumeApplication(Application& application)
    + StopApplication(Application& application)
    + GetNvsSettings() : NvsSettings&
    + SyncNvsSettings()
    - DisableTm1637Displays()
    - ResetLeds()
    - ClearLedStrips()
}

ApplicationsManager -u-|> IEventListener

package QueueHandlers
{
    class QueueWriters
    {
        + GetI2cOutputQueueWriter(): I2cOutputQueueWriter& 
        + GetSpiOutputQueueWriter(): SpiOutputQueueWriter& 
        + GetLedStripsQueueWriter(): LedStripsQueueWriter&
    }

    class QueueProcessor <<M30_Messages>> {}

    class I2cInputQueueReader
    {
        + I2cInputQueueReader(\n I2cInputQueue& i2cInputQueue,\n ApplicationsManager& applicationsManager)
        + HandleMessage() : bool
    }

    I2cInputQueueReader -u-|> QueueProcessor

    I2cInputQueueReader o-- ApplicationsManager

    class I2cOutputQueueWriter
    {
        + I2cOutputQueueWriter(\n I2cOutputQueue& i2cOutputQueue,\n ApplicationsManager& applicationsManager)
        + SendLed(ELedId id, bool state)
        + SendLcd2004PredefinedCharacter(\n uint8_t slotIndex,\n uint8_t predefinedCharacterIndex)
        + SendLcd2004CustomCharacter(\n uint8_t slotIndex,\n uint8_t data[8])
        + SendLcd2004Line(\n uint8_t lineNumber, std::string line)
        + SendTm1637Brightness(\n Types::ETm1637Id tm1637Id,\n uint8_t brightness)
        + SendTm1637Value(\n Types::ETm1637Id tm1637Id,\n uint32_t value)
        + SendTm1637Time(\n Types::ETm1637Id tm1637Id,\n uint8_t first,\n uint8_t second)
    }

    I2cOutputQueueWriter -u-|> QueueProcessor

    class SpiInputQueueReader
    {
        + SpiInputQueueReader(\n SpiInputQueue& spiInputQueue,\n ApplicationsManager& applicationsManager)
        + HandleMessage() : bool
    }

    SpiInputQueueReader -u-|> QueueProcessor

    SpiInputQueueReader o-- ApplicationsManager

    class SpiOutputQueueWriter
    {
        SpiOutputQueueWriter(\n SpiOutputQueue& spiOutputQueue,\n ApplicationsManager& applicationsManager)
    }

    SpiOutputQueueWriter -u-|> QueueProcessor

    class LedStripsQueueWriter
    {
        + LedStripsQueueWriter(\n LedStripsQueue& i2cInputQueue,\n ApplicationsManager& applicationsManager)
        + SendLedStripsBrightness(uint8_t brightness)
        + SendPixel(\n uint8_t x, uint8_t y,\n uint8_t red, uint8_t green, uint8_t blue)
        + SendFrameReady()
    }

    LedStripsQueueWriter -u-|> QueueProcessor
    
    QueueWriters o-- I2cOutputQueueWriter
    QueueWriters o-- LedStripsQueueWriter
    
    ApplicationsTask *-- QueueWriters
    ApplicationsTask *-- LedStripsQueueWriter
    ApplicationsTask *-- I2cInputQueueReader
    ApplicationsTask *-- I2cOutputQueueWriter
    ApplicationsTask *-- SpiInputQueueReader
    ApplicationsTask *-- SpiOutputQueueWriter

    ApplicationsManager o-- QueueWriters

    class I2cInputQueue <<M30_MESSAGE_LAYER>>
    {
    }

    class I2cOutputQueue <<M30_MESSAGE_LAYER>>
    {
    }

    class LedStripsQueue <<M30_MESSAGE_LAYER>>
    {
    }

    ApplicationsTask *-- I2cInputQueue
    ApplicationsTask *-- I2cOutputQueue
    ApplicationsTask *-- LedStripsQueue

    I2cInputQueueReader  o-- I2cInputQueue
    I2cOutputQueueWriter o-- I2cOutputQueue 
    SpiInputQueueReader  o-- SpiInputQueue
    SpiOutputQueueWriter o-- SpiOutputQueue 
    LedStripsQueueWriter o-- LedStripsQueue
}

package "I/O States"
{
    class JoystickState 
    {
        + EJoystickDirection { 
            Centered, Up, UpRight, Right, DownRight, \nDown, DownLeft, Left, UpLeft }
        - direction : EJoystickDirection
        - buttonState : bool
        + GetDirection() : EJoystickDirection
        + SetDirection(EJoystickDirection joystickDirection)
        + GetButtonState() : bool
        + SetButtonState(bool state)
    }
    
    class ButtonState 
    {
        - state : bool
        + GetState() : bool
        + SetState(bool state)
    }
    
    class IoStates
    {
        + EJoystickId : { Player1, Player2 }
        + GetJoystickState(EJoystickId): JoystickState
        + GetSystemButtonState(): ButtonState
    }

    IoStates *--"2" JoystickState
    IoStates *-- ButtonState
}

package "Applications" 
{
    interface IApplication 
    {
        + {abstract} Start()
        + {abstract} Pause()
        + {abstract} Resume()
        + {abstract} Stop()
        + {abstract} Run()
    }

    abstract class Application <<abstract>>
    {
        + EId { Menu, Pong }  
        + EType { Menu, Game, Demo, Tool, Utility }
        + GetApplicationsManager() : ApplicationsManager
        + GetId() : EId
        + GetType() : EType
        + GetName() : string
        + GetContext() : Context&
        - _id : EId
        - _type : EType
        - _name : string
        - _context : Context
        # _send : Send
    }

    Application -u-|> IApplication
    Application -u-|> IEventListener

    
    class Send
    {
        + Send(QueueWriters& queueWriters)
        'LEDs
        + Led(ELedId ledId, bool state)
        'LCD2004
        + Line(uint8_t line, char[16] line)
        'LED Strips
        + Orientation(bool horizontal)
        + Pixel(uint8_t x, uint8_t y, RGB rgb)
        + Row(uint8_t row, RGB rgb)
        + Column(uint8_t column, RGB rgb)
        'TM1637
        + Value(Types::ETm1637 id, uint32_t value)
        + Time(Types::ETm1637 id, uint8_t first, uint8_t second)
    }
    Send o-- QueueWriters

    Application *-- Send

    package "Menu Application" as MenuApplicationPackage
    {
        class MenuApplication 
        {
            + Start()
            + Pause()
            + Resume()
            + Stop()
            + Run()
            + OnJoystickDirectionChanged(
                IoStates::EJoystickId id, \nJoystickState::EDirection direction)
            + OnJoystickButtonChanged(
                IoState:EJoystickId id, bool state)
            + OnSystemButtonChanged(bool state)
            - Render(bool alwaysRender = false)
        }

        class States
        {
            - WELCOME_STATE_TIME : const microseconds = 2s
            - NVS_SYNC_TIME : const microseonds = 10s
            + enum class EState { S000_Welcome, S010_SelectAplicationpType, ...}
            + enum class EViewMode {\n Recent, MostUsed, Favorites, Alphabetic, Tag, New, Random, Last }
            + enum class EApplicationMode {\n Idle, Running, Paused, Quit, Settings, Highscores, Favorite, ... }
            + States(Random& random,\n ApplicationsManager& applicationsManager)
            + GetSelectedApplicationIndex() const : uint16_t
            + SetSelectedApplicationIndex(\n uint16_t selectedApplicationIndex)
            + GetSelectedViewMode() const : EViewMode 
            + SetSelectedViewMode(\n EViewMode selectedViewMode)
            + GetSelectedTagIndex() const : uint8_t
            + SetSelectedTagIndex(\n uint8_t selectedTagIndex)
            + GetSelectedApplicationType() const Application::EType
            + SetSelectedApplicationType(\n Application_EType selectedApplicationType)
            + GetselectedApplicationMode() : EApplicationMode
            + GetSelectedHighscoreIndex() const uint8_t
            + GetSwapFavoriteStatus() const : bool
            + GetCurrentState() const : EState
            + GetSelectableTags() const: vector<Application_ETag>
            + GetselectableAPplications() const
            + SortSelectableApplications()
            + bool OnTimePassed()
            + void OnSystemButtonPressed()
            + void OnJoystickDirectionChanged(
                JoystickState::EDirection direction)
            + void OnJoystickUp()
            + void OnJoystickRight()
            + void OnJoystickDown()
            + void OnJoystickLeft()
            + void OnJoystickButtonPressed()
            - _MAX_HIGH_SCORES_ENTRIES {static} : const uint8_t = 10
            - _currentState : EState
            - _previousState : EState
            - _timeInCurrentState : microseconds
            - _timeSinceNvsSync : microseconds
            - _selectrableTags : vector<Application_ETag>
            - _selectableApplications: vector<Application*>
            - _selectedApplicationMode : EApplicationMode
            - _selectedHighscoreIndex : uint8_t
            - _swapFavoriteStatus : bool 
            - SetstateIf(bool condition, EState newState)
            - SetState(EState newState)
            - ExecuteCurrentState()
            - FilterSelectableTags()
            - FilterSelectableApplications()
            - FilterTag(IApplication_ETag tag0
            - ProcessApplicationMode()
        }

        class Renderer 
        {
            + NR_OF_LINES {static} : const uint8_t = 4
            + Renderer(\n const ApplicationsManager& applicationsManager,\n States& states)
            + Render(const States& states) : array<string, NR_OF_LINES>
            + IsDirty() const : bool
            + struct Result { string line1, string line2 }
            + GetMenuApplication() : MenuApplication
            + GetCurrentResult() const : array<string, NR_OF_LINES>
            - NR_OF_ITEM_LINES {static} : const int = NR_OF_LINES - 1
            - RenderSxxx()
            - RenderItems(\n const vector<T>& lookupTable,\n uint16_selectedIndex)
            - vector<string_view> FilterTagsLookupTable(\n const vector<string_view>& lookupTable) const
            - vector<string_view> FilterApplicationModesLookupTable(\n const vector<string_view>& lookupTable) const
            - FillCurrentResult(\n const array<int16_t, NR_OF_ITEM_LINES>& lineItemIndices,\n int16_t selectedItemIndex,\n uint16_t nrOfItems,\n const vector<T>& lookupTable)     
            - CalculateSymbol(\n uint8_t lineIndex,\n int16_t itemIndex,\n int16_t selectedItemIndex,\n uint16_t nrOfItems) const : char
            - Cls(array<string, NR_OF_LINES>& result)
            - GetApplicationTypeString(Application_EType applicationType) const : string
            - GetViewModeString(States_EViewMode viewMode) const : string
            - GetTagString(Application_ETag tag) const : string
            - GetHighscoreName(uint8_t index) const : string
            - GetHighscoreValue(uint8_t index) const : uint32_t
            - _lines : array<string, NR_OF_LINES>
            - _previousResult : array<std::string, NR_OF_LINES>
            - _currentResult : array<std::string, NR_OF_LINES>
        }

        struct IterationLine
        {
            symbol : char
            index : int16_t
        }

        Renderer *-- "3"IterationLine
        MenuApplication *-- States
        MenuApplication *-- Renderer
    }        

    package "Games" as GamesPackages
    {
        class Game
        {
            Game(Context& context,\n ApplicationsManager& applicationsManager)
        }

        class Highscores
        {
            + MAX_NR_OF_ENTRIES {static} : const int = 25
            + Highscores()
        }

        class Highscore
        {
            + MAX_NAME_LENGTH {static} : const int = 8
            + Highscore()
            + GetName() : string_view
            + GetScore : uint32_t
            - _name : char[MAX_NAME_LENGTH]
            - _score : uint32_t
        }

        Game *-- Highscores
        Highscores *-- Highscore : array
    }

    class Utility 
    {
        + Utility()
    }
}

MenuApplication -u--|> Application

ApplicationsTask *-- ApplicationsManager : _applicationsManager
ApplicationsManager *-- Application : _activeApplication, \n_pausedApplication
ApplicationsManager *-- "*" Application : _applications
note on link
    Menu is always 
    application [0]
end note

ApplicationsManager *-- MenuApplication
ApplicationsManager *-- IoStates

class NvsSettings
{
    + NVS_VERSION_KEY {static} : const string
    + LOG_LEVELS_KEY {static} : const string
    + SEVEN_SEGMENT_BRIGHTNESS_KEY {static} : const string
    + LED_STRIPS_BRIGHTNESS_KEY {static} : const string
    + LAST_SELECTED_APPLIATION_INDEX_KEY {static} : const string
    + LAST_SELECTED_VIEW_MODE_INDEX_KEY {static} : const string
    + LAST_SELECTED_APPLICATION_TYPE_INDEX_KEY {static} : const string
    + LAST_SELECTED_TAG_INDEX_KEY {static} : const string
    + NvsSettings(\nContext& context, \nApplicationsManager& applicationsManager,
        I2cOutputQueueWriter& i2cOutputQueueWriter, \nLedStripsQueueWriter& ledStripsQueueWriter)
    + Read()
    + GetNvsVersion() const : uint8_t 
    + GetLogLevels() const : uint32_t 
    + void SetLogLevels(uint32_t logLevels)
    + Get7SegmentsBrightness() const : uint8_t
    + Set7SegmentsBrightness(uint8_t brightness)
    + GetLedStripsBrightness() const : uint8_t
    + SetLedStripsBrightness(uint8_t brightness)
    + GetLastSelectedApplicationIndex() const : uint16_t
    + SetLastSelectedApplicationIndex(
        uint16_t lastSelectedApplicationIndex)
    + GetLastSelectedViewModeIndex() const : uint8_t
    + SetLastSelectedViewModeIndex(
        uint8_t lastSelectedViewModeIndex)
    + GetLastSelectedApplicationTypeIndex() const : uint8_t 
    + SetLastSelectedApplicationTypeIndex(
        uint8_t lastSelectedApplicationTypeIndex)
    + GetLastSelectedTagIndex() const : uint8_t
    + SetLastSelectedTagIndex(
        uint8_t lastSelectedTagIndex)
    + Sync()
    - ReadNvsVersion();
    - ReadLogLevels();
    void Read7SegmentsBrightness();
    void ReadLedStripsBrightness();
    void ReadApplicationSettings();
    void ReadLastSelectedApplicationIndex();
    void ReadLastSelectedViewModeIndex();
    void ReadLastSelectedApplicationTypeIndex();
    void ReadLastSelectedTagIndex();
    void SyncLogLevelsToNvs();
    void Sync7SegmentsBrightnessToNvs();
    void SyncLedStripsBrightnessToNvs();
    void SyncApplicationSettingsToNvs();
    void SyncLastSelectedApplicationIndexToNvs();
    void SyncLastSelectedViewModeIndexToNvs();
    void SyncLastSelectedApplicationTypeIndexToNvs();
    void SyncLastSelectedTagIndexToNvs();
    uint8_t _nvsVersion;
    uint32_t _logLevels;
    uint8_t _sevenSegmentsBrightness;
    uint8_t _ledStripsBrightness;
    uint16_t _lastSelectedApplicationIndex;
    uint8_t _lastSelectedViewModeIndex;
    uint8_t _lastSelectedApplicationTypeIndex;
    uint8_t _lastSelectedTagIndex;    
}

NvsSettings o-- ApplicationsManager
NvsSettings o-- I2cOutputQueueWriter
NvsSettings o-- LedStripsQueueWriter

@enduml
