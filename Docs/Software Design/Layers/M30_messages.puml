@startuml

title M30 RTOS MESSAGES \n BETWEEN APPLICATIONS LAYER AND DOMAIN MODELS LAYER

skinparam packageStyle rectangle
skinparam lineThickness 2

'------------------------------------------------------------------------------------------------
'                           APPLICATIONS LAYER 
'------------------------------------------------------------------------------------------------

package "Applications Layer" #ff8
{
    class ApplicationsTask {}
} 

class Queue
{
    + void Queue() 
    + SetRtosQueue(RtosQueue& rtosQWueue) 
    + GetRtosQueue() : RtosQueue&
}

Queue *-- RtosQueue : _rtosQueue

class Types
{
    enum class EJoystickId { Player1, Player2 }
    enum class EJoystickDirection { Centered, Up, UpRight, Right, DownRight, Down, DownLeft, Left, UpLeft }
    enum class ELedId { Player1, Player2, PlayPause, Select, Setup }
    enum class ETm1637Id { CentralPanel, Player, Player 2 }
}

package "LedStrips" as LedStripsPackage
{       
    class Color
    {
        + Color()
        + Color(uint8_t red, uint8_t green, uint8_t blue)
        + Set(uint8_t red, uint8_t green, uint8_t blue)
        + SetRed(uint8_t red)
        + SetGreen(uint8_t green)
        + SetBlue(uint8_t blue)
        + Get(uint8_t& red, uint8_t& green, uint8_t& blue)
        + GetRed() const : uint8_t
        + GetGreen() const : uint8_t
        + GetBlue() const : uint8_t
        + GetSum() const : uint16_t 
        + AdjustBrightness(uint8_t brightness) 
        + Operator=(const Color& other)
        + Operator==(const Color& other) : bool
        + Operator!=(const Color& other) : ool
        + Operator+=(const Color& other)
        + Operator-=(const Color& other)
        - _red : uint8_t
        - _green : uint8_t
        - _blue : uint8_t
    }

    class Position
    {
        + Position()
        + Position(uint8_t x, uint8_t y)
        + Set(uint8_t x, uint8_t y)
        + SetX(uint8_t x)
        + SetY(uint8_t y)
        + Get(uint8_t& x, uint8_t& y)
        + GetX() const : uint8_t&
        + GetY() const : uint8_t&
        + Operator==(const Position& other) : bool
        + Operator!=(const Position& other) : ool
        + Operator+=(const Position& other)
        + Operator-=(const Position& other)
        - _x : uint8_t
        - _y : uint8_t
    }

    class LedStripsQueue 
    {
        + LedStripsQueue()
        + MESSAGE_QUEUE_LENGTH {static} : const uint32_t = 25
        + MESSAGE_QUEUE_ITEM_SIZE {static} : const uint32_t = sizeof_Message
    }

    LedStripsQueue -u-|> Queue

    struct message
    {    
        + enum class EType { Brightness, Pixel, FrameReady }
        + EType type
    }    

    struct brightness
    {
        percentage : uint8_t
    }

    struct pixel 
    {
        x : uint8_t 
        y : uint8_t 
        red : uint8_t
        green : uint8_t
        blue : uint8_t
    }

    struct frameReady 
    {
    }

    message o-- brightness
    message o-- pixel
    message o-- frameReady

    ApplicationsTask --> LedStripsQueue
    LedStripsQueue *-- message

    message ...> Types    
}

package "I2c" as I2cPackage
{
    package "I2cInputQueue" AS i2cInputQueuePackage
    {
        class I2cInputQueue
        {
            + I2cInputQueue()
            + MESSAGE_QUEUE_LENGTH {static} : const uint32_t = 25
            + MESSAGE_QUEUE_ITEM_SIZE {static} : const uint32_t = sizeof_Message
        }

        I2cInputQueue -u-|> Queue

        struct message
        {
            + enum class EType { JoystickDirection, JoystickButton, SystemButton }
            + EType type
        }
        
        struct joystickDirection
        {
            EJoystickId joystickId
            EJoystickDirection direction
        }

        struct joystickButton
        {
            EJoystickId id
            bool pressed
        } 

        struct systemButton
        {
            bool pressed
        } 

        message *-- joystickDirection : union
        message *-- joystickButton : union
        message *-- systemButton : union

        I2cInputQueue *-- message
        ApplicationsTask <-- I2cInputQueue

        message ...> Types
    }

    package "I2cOutputQueue" AS i2cOutQueuePackage
    {
        class I2cOutputQueue
        {
            + I2cOutputQueue()
            + type : EType
            + MESSAGE_QUEUE_LENGTH {static} : const uint32_t = 25
            + MESSAGE_QUEUE_ITEM_SIZE {static} : const uint32_t = sizeof_Message
        }

        I2cOutputQueue -u-|> Queue

        struct message
        {
            + enum class EType { Led, Lcd2004PredefinedCharacter, ... }
            + EType type
        }

        struct led
        {
            + Types::ELedId ledId
            + bool state
        }

        struct lcd2004PredefinedCharacter
        {
            + slotIndex : uint8_t
            + predefinedCharacterIndex : uint8_t
        }

        struct lcd2004CustomCharacter
        {
            + number : uint8_t
            + data : uint8_t[8]
        }

        struct lcd2004Line 
        {
            + uint8_t lineNumber
            + lineContent : char[Lcd2004::LINE_WIDTH]
        }

        struct tm1637Enable
        {
            + tm1637Id : Types::ETm1637Id
            + on : bool
        }

        struct tm1637Brightness
        {
            + tm1637Id : Types::ETm1637Id
            + brightness : uint8_t 
        }

        struct tm1637Value
        {
            + tm1637Id : Types::ETm1637Id
            + value : uint32_t
        } 

        struct tm1637Time
        {
            + tm1637Id : Types::ETm1637Id
            + first : uint8_t
            + second : uint8_t
        }

        message *-- led : union
        message *-- lcd2004PredefinedCharacter : union
        message *-- lcd2004CustomCharacter : union
        message *-- lcd2004Line : union
        message *--- tm1637Enable : union
        message *--- tm1637Brightness : union
        message *--- tm1637Value : union
        message *--- tm1637Time : union

        I2cOutputQueue *-- message
        ApplicationsTask --> I2cOutputQueue

        message ...> Types
    }
}


