class QueueProcessor <<M30_Messages>> <<abstract>>
{
    + QueueProcessor()
    - GetQueue() : Queue&
    + SetQueue(Queue& queue)
}

QueueProcessor *-- Queue : Queue*

package "Domain Models Layer" as DomainModelsLayer #fc8
{
    class I2cTask <<I2cTask>> #yellow
    class SpiTask <<SpiTask>> #lightgreen
    class LedStripsTask <<LedStripTask>> #lightblue
}

LedStripsQueue --> LedStripsTask
I2cOutputQueue --> I2cTask
I2cInputQueue <-- I2cTask
SpiOutputQueue --> SpiTask
SpiInputQueue <-- SpiTask

class DiagnosticsTask <<M00 Systems Layer>> #lightgrey
{
}

package "Diagnostics" as DiagnosticsPackage
{
    class DiagnosticsQueue <<queue>> 
    {
        + DiagnosticsQueue()
        + ~DiagnosticsQueue()
        + MESSAGE_QUEUE_LENGTH {static} : const uint32_t = 1000
        + MESSAGE_QUEUE_ITEM_SIZE {static} : const uint32_t = sizeof_Message
    }

    struct message
    {
        + Type { HeartBeat, TaskData, LogEntry } : enum class
        + type : EType
    }

    struct header 
    {
        + Types_ETaskId taskId
        + microseconds timeStamp; 
    }

    struct heartBeat
    {
    }

    heartBeat *-- header

    struct taskData
    {
        + uint32_t stackSize
    }

    taskData *-- header

    struct logEntry
    {
        + Types::ELogLevel logLevel
        + char text[DiagnosticsQueue::MAX_LOG_ENTRY_TEXT_LENGTH]
    }

    logEntry *-- header

    DiagnosticsQueue *-- message
    DiagnosticsQueue --> DiagnosticsTask

    message o-- heartBeat : union
    message o-- taskData : union
    message o-- logEntry : union
}

ApplicationsTask --> LedStripsQueue

@enduml
