# Folders to include (L0 ... L9)
$includeFolders = @("L0_", "L1_", "L2_", "L3_", "L4_", "L5_", "L6_", "L7_", "L8_", "L9_")

# File types to count as source code
$sourceExtensions = @(".cpp", ".hpp", ".h", ".c")

function Count-ExecutableLines($path) {
    $count = 0
    $inBlockComment = $false

    foreach ($line in Get-Content $path) {
        $trim = $line.Trim()

        if ($trim -eq "") { continue }

        if ($trim.StartsWith("/*")) {
            $inBlockComment = $true
            continue
        }
        if ($inBlockComment) {
            if ($trim.EndsWith("*/")) { $inBlockComment = $false }
            continue
        }

        if ($trim.StartsWith("//")) { continue }
        if ($trim.StartsWith("*")) { continue }

        $count++
    }

    return $count
}

function Count-AllLines($path) {
    $raw = Get-Content $path -Raw -ErrorAction SilentlyContinue
    if ($null -eq $raw) { return 0 }
    return ($raw.Split("`n").Count)
}

# --- FIND PROJECT ROOT (folder containing "main") ---
function Find-ProjectRoot {
    $dir = Get-Location

    while ($dir -ne $null) {
        if (Test-Path (Join-Path $dir "main")) {
            return $dir
        }
        $dir = $dir.Parent
    }

    throw "Kan projectroot niet vinden (geen 'main' folder gevonden)."
}

$projectRoot = Find-ProjectRoot
$mainFolder  = Join-Path $projectRoot "main"

# --- COLLECT ALL SOURCE FILES UNDER main/L0..L9 ---
$items = Get-ChildItem -Recurse -File -Path $mainFolder |
    Where-Object {
        ($sourceExtensions -contains $_.Extension) -or
        ($_.Name -eq "CMakeLists.txt")
    } |
    Where-Object {
        $filePath = $_.FullName
        foreach ($prefix in $includeFolders) {
            if ($filePath -like "*\$prefix*") { return $true }
        }
        return $false
    } |
    ForEach-Object {
        [PSCustomObject]@{
            Path       = $_.FullName
            Folder     = Split-Path $_.FullName -Parent
            File       = $_.Name
            ExecLines  = Count-ExecutableLines $_.FullName
            AllLines   = Count-AllLines $_.FullName
        }
    }

# --- DETECT ONLY L0..L9 TOP-LEVEL FOLDERS ---
$topLevelFolders = Get-ChildItem -Directory -Path $mainFolder |
    Where-Object {
        $_.Name -match "^L[0-9]_"
    } |
    Select-Object -ExpandProperty FullName |
    Sort-Object -Unique

# --- BUILD AGGREGATE ONLY FOR L0..L9 ---
$folderAgg = foreach ($folder in $topLevelFolders) {

    $folderName = Split-Path $folder -Leaf

    $execTotal = ($items |
        Where-Object { $_.Path -like "*\$folderName\*" } |
        Measure-Object -Property ExecLines -Sum).Sum

    $allTotal = ($items |
        Where-Object { $_.Path -like "*\$folderName\*" } |
        Measure-Object -Property AllLines -Sum).Sum

    [PSCustomObject]@{
        Folder     = $folderName
        ExecLines  = $execTotal
        AllLines   = $allTotal
    }
}

function Print-FolderTree($folderName) {
    $node = $folderAgg | Where-Object { $_.Folder -eq $folderName }
    if (-not $node) { return }

    "{0,-40}{1,10}{2,10}" -f $folderName, $node.ExecLines, $node.AllLines

    $items |
        Where-Object { $_.Path -like "*\$folderName\*" } |
        Sort-Object File |
        ForEach-Object {
            "{0,-40}{1,10}{2,10}" -f ("|  " + $_.File), $_.ExecLines, $_.AllLines
        }
}

"=== SOURCE TREE (L0..L9) ==="
"Folder                                   ExecLines  AllLines"

foreach ($row in $folderAgg) {
    Print-FolderTree $row.Folder
}

"`n=== SUMMARY L0..L9 ==="
"{0,-20}{1,12}{2,12}{3,12}{4,12}" -f "Folder", "ExecLines", "AllLines", "%Exec", "%All"

$totalExec = ($folderAgg | Measure-Object -Property ExecLines -Sum).Sum
$totalAll  = ($folderAgg | Measure-Object -Property AllLines -Sum).Sum

foreach ($row in $folderAgg) {

    $pctExec = if ($totalExec -gt 0) { "{0:N1}" -f (($row.ExecLines / $totalExec) * 100) } else { "0.0" }
    $pctAll  = if ($totalAll -gt 0)  { "{0:N1}" -f (($row.AllLines  / $totalAll)  * 100) } else { "0.0" }

    "{0,-20}{1,12}{2,12}{3,12}{4,12}" -f $row.Folder, $row.ExecLines, $row.AllLines, $pctExec, $pctAll
}

"`nTOTALS:"
"{0,-20}{1,12}{2,12}" -f "ALL", $totalExec, $totalAll
